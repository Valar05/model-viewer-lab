{
  "name": "model-viewer-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node tools/serve_viewer.mjs",
    "link": "node tools/make_model_viewer_link.mjs",
    "smoke": "node tools/smoke_viewer.mjs",
    "pages-link": "node tools/make_github_pages_model_review_link.mjs",
    "validate:review-state": "node tools/validate_review_state.mjs docs/examples/review-state-v2.json",
    "ci": "npm run build && npm run smoke && npm run smoke:mechanism && npm run validate:review-state && npm run validate:hard-surface-factory && npm run validate:mechanisms && npm run validate:upper-glacis && npm run validate:meshy-component-kit",
    "validate:hard-surface-factory": "node labs/hard-surface-factory/scripts/validate_factory_inventory.mjs",
    "mechanism-link": "node tools/make_mechanism_viewer_link.mjs",
    "smoke:mechanism": "node tools/smoke_mechanism_viewer.mjs",
    "validate:mechanisms": "node labs/hard-surface-factory/scripts/validate_mechanism_inventory.mjs",
    "generate:upper-glacis": "node labs/hard-surface-factory/tools/generators/generate_upper_glacis_manufactured_v1.mjs",
    "validate:upper-glacis": "node labs/hard-surface-factory/tools/validators/validate_upper_glacis_output.mjs",
    "generate:meshy-component-kit": "node labs/hard-surface-factory/tools/generators/generate_meshy_component_kit.mjs",
    "validate:meshy-component-kit": "node labs/hard-surface-factory/tools/validators/validate_meshy_component_kit.mjs"
  },
  "dependencies": {
    "three": "^0.166.1"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.28.1",
    "typescript": "^5.7.3",
    "@types/node": "^22.13.5"
  }
}
